# ========================================================
# 🎮 Unity Project .gitignore
# โปรเจกต์ Car-Action (Unity 6 / URP)
# ========================================================

# --------------------------------------------------------
# 1. Unity Generated Folders & Temporary Files (โฟลเดอร์แคชและไฟล์ชั่วคราวของ Unity)
# --------------------------------------------------------
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/
[Pp]ackageCache/
ExportedObj/
.consulo/

# --------------------------------------------------------
# 2. Build Binaries & Output (ไฟล์ผลลัพธ์จากการ Build ห้ามขึ้น Git)
# --------------------------------------------------------
[Bb]uild/
[Bb]uilds/
Build_PC/
Build_WebGL/
*.exe
*.wasm
*.data
*.symbols.json
*.log
*.apk
*.aab
*.unitypackage
*.app
*.dmg

# --------------------------------------------------------
# 3. IDE / Editor Solution & Project Files (ไฟล์โปรเจกต์ของ IDE เช่น VS Code, Visual Studio, Rider)
# --------------------------------------------------------
.vs/
.idea/
.vscode/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.pdb.meta
*.mdb
*.mdb.meta
*.opendb
*.VC.db

# --------------------------------------------------------
# 4. Crash Reports & Profiling
# --------------------------------------------------------
sysinfo.txt
crashlytics-build.properties
Assets/Resources/PerformanceTestRun*

# --------------------------------------------------------
# 5. OS Generated Files (ไฟล์ขยะของระบบปฏิบัติการ)
# --------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# --------------------------------------------------------
# 6. Test Media / Screenshots (ภาพแคปเจอร์หน้าจอและสื่อทดสอบขนาดใหญ่)
# --------------------------------------------------------
Assets/Screenshots/
[Aa]ssets/[Ss]creenshots/

# --------------------------------------------------------
# 7. Asset Meta Files Safeguard (ห้ามละเลยไฟล์ .meta ใน Assets)
# --------------------------------------------------------
![Aa]ssets/**/*.meta
